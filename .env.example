# OPNsense connection
OPNSENSE_HOST=https://192.168.1.1
OPNSENSE_API_KEY=your_api_key_here
OPNSENSE_API_SECRET=your_api_secret_here

# Gateway name to monitor RTT/loss AND auto-resolve the WAN interface (e.g. Port2_WAN)
# Leave OPNSENSE_GATEWAY empty to monitor all gateways
OPNSENSE_GATEWAY=WAN_DHCP

# Interface override — leave empty to auto-detect from the gateway above
# Only set this if auto-detection fails (e.g. ix1, igb0, vtnet0)
OPNSENSE_INTERFACE=

# Interface for top talkers (e.g. lan, opt1) — leave empty for auto-discovery
OPNSENSE_TOP_IF=

# Set to true if OPNsense uses a valid SSL certificate
OPNSENSE_VERIFY_SSL=false

# How often to poll OPNsense (seconds)
POLL_INTERVAL=60
