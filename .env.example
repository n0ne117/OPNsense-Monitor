# OPNsense connection
OPNSENSE_HOST=https://192.168.1.1
OPNSENSE_API_KEY=your_api_key_here
OPNSENSE_API_SECRET=your_api_secret_here

# Interface to monitor bandwidth on (e.g. em0, igb0, vtnet0)
OPNSENSE_INTERFACE=em0

# Gateway name to monitor RTT/loss (leave empty to monitor all gateways)
OPNSENSE_GATEWAY=

# Set to true if OPNsense uses a valid SSL certificate
OPNSENSE_VERIFY_SSL=false

# How often to poll OPNsense (seconds)
POLL_INTERVAL=60
